<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Flowers by Sabi' %> | Магазин цветов</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css">
    
    <style>
        :root {
            --primary-color: #e83e8c;
            --secondary-color: #20c997;
            --light-pink: #fff5f7;
            --dark-color: #343a40;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f9fa;
            padding-top: 80px; /* Отступ для фиксированной навигации */
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Dancing Script', cursive;
            color: var(--primary-color);
        }
        
        .logo-font {
            font-family: 'Dancing Script', cursive;
            font-weight: 700;
        }
        
        /* Навигация */
        .navbar {
            background-color: white;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }
        
        .navbar-brand {
            font-size: 2rem;
            color: var(--primary-color) !important;
        }
        
        .nav-link {
            color: var(--dark-color) !important;
            font-weight: 500;
            margin: 0 5px;
            transition: all 0.3s;
        }
        
        .nav-link:hover {
            color: var(--primary-color) !important;
            transform: translateY(-2px);
        }
        
        .nav-link.active {
            color: var(--primary-color) !important;
            border-bottom: 2px solid var(--primary-color);
        }
        
        /* Кнопки */
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .btn-primary:hover {
            background-color: #d81b60;
            border-color: #d81b60;
        }
        
        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .btn-outline-primary:hover {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        /* Карточки товаров */
        .product-card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 20px;
        }
        
        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        
        .product-img {
            height: 250px;
            object-fit: cover;
        }
        
        .badge-sale {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: var(--secondary-color);
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
        }
        
        /* Футер */
        footer {
            background: linear-gradient(135deg, var(--dark-color) 0%, #495057 100%);
            color: white;
            margin-top: 50px;
            padding: 40px 0 20px;
        }
        
        .social-icons a {
            color: white;
            font-size: 1.5rem;
            margin: 0 10px;
            transition: color 0.3s;
        }
        
        .social-icons a:hover {
            color: var(--primary-color);
        }
        
        /* Сессия и пользователь */
        .session-info {
            background-color: var(--light-pink);
            border-radius: 10px;
            padding: 15px;
            margin: 20px 0;
            font-size: 0.9rem;
        }
        
        .user-menu .dropdown-toggle::after {
            display: none;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary-color);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        /* Адаптивность */
        @media (max-width: 768px) {
            body {
                padding-top: 60px;
            }
            
            .navbar-brand {
                font-size: 1.5rem;
            }
            
            .product-img {
                height: 200px;
            }
        }
    </style>
</head>
<body>
    <!-- Навигация -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand logo-font" href="/">
                <i class="fas fa-rose"></i> Flowers by Sabi
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Основное меню -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <% if (nav && nav.length > 0) { 
                        nav.forEach(function(item) { %>
                            <li class="nav-item">
                                <a class="nav-link <%= item.isActive ? 'active' : '' %>" href="<%= item.url %>">
                                    <% if (item.icon) { %><%= item.icon %> <% } %>
                                    <%= item.title %>
                                </a>
                            </li>
                        <% });
                    } else { %>
                        <!-- Резервное меню -->
                        <li class="nav-item">
                            <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
                                <i class="fas fa-home"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= currentPath.includes('/roses') ? 'active' : '' %>" href="/roses">
                                <i class="fas fa-rose"></i> Розы
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= currentPath.includes('/bouquets') ? 'active' : '' %>" href="/bouquets">
                                <i class="fas fa-birthday-cake"></i> Букеты
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= currentPath.includes('/cart') ? 'active' : '' %>" href="/cart">
                                <i class="fas fa-shopping-cart"></i> Корзина
                            </a>
                        </li>
                    <% } %>
                </ul>
                
                <!-- Пользователь и корзина -->
                <div class="d-flex align-items-center">
                    <!-- Корзина -->
                    <a href="/cart" class="btn btn-outline-primary me-3 position-relative">
                        <i class="fas fa-shopping-cart"></i>
                        <% if (cartItemCount && cartItemCount > 0) { %>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cartItemCount %>
                            </span>
                        <% } %>
                    </a>
                    
                    <!-- Пользователь -->
                    <% if (isAuthenticated && currentUser) { %>
                        <div class="dropdown user-menu">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" 
                               data-bs-toggle="dropdown">
                                <div class="user-avatar me-2">
                                    <%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <span class="d-none d-md-inline"><%= currentUser.username %></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text fw-bold">
                                        <i class="fas fa-user-circle me-2"></i>
                                        <%= currentUser.fullName || currentUser.username %>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/auth/profile">
                                        <i class="fas fa-user me-2"></i>Личный кабинет
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/orders">
                                        <i class="fas fa-shopping-bag me-2"></i>Мои заказы
                                    </a>
                                </li>
                                <% if (isAdmin) { %>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="/admin">
                                            <i class="fas fa-cog me-2"></i>Админ панель
                                        </a>
                                    </li>
                                <% } %>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/auth/logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Выйти
                                    </a>
                                </li>
                            </ul>
                        </div>
                    <% } else { %>
                        <!-- Кнопки входа и регистрации -->
                        <div class="btn-group" role="group">
                            <a href="/auth/login" class="btn btn-outline-primary">
                                <i class="fas fa-sign-in-alt"></i> Войти
                            </a>
                            <a href="/auth/register" class="btn btn-primary">
                                <i class="fas fa-user-plus"></i> Регистрация
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Основной контент -->
    <main class="container py-4">
        <!-- Уведомления -->
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <!-- Приветствие -->
        <% if (userName && userName !== 'Гость') { %>
            <div class="alert alert-info">
                <h5 class="alert-heading">
                    <i class="fas fa-heart"></i> Добро пожаловать, <%= userName %>!
                </h5>
                <% if (visitCount && visitCount > 1) { %>
                    <p class="mb-0">
                        Вы посещаете нас уже <strong><%= visitCount %></strong> раз!
                        <% if (lastVisit) { %>Ваш последний визит был: <%= lastVisit %><% } %>
                    </p>
                <% } %>
            </div>
        <% } %>
        
        <!-- Контент страницы -->
        <%- body %>
        
        <!-- Информация о сессии (для отладки) -->
        <% if (process.env.NODE_ENV === 'development' && sessionID) { %>
            <div class="session-info mt-5">
                <h6><i class="fas fa-info-circle"></i> Отладочная информация</h6>
                <div class="row">
                    <div class="col-md-6">
                        <small><strong>ID сессии:</strong> <code><%= sessionID.substring(0, 15) %>...</code></small><br>
                        <small><strong>Запросов:</strong> <%= sessionCounter || 0 %></small>
                    </div>
                    <div class="col-md-6">
                        <small><strong>Последний запрос:</strong> <%= lastRequest || 'только что' %></small><br>
                        <small><strong>Истекает через:</strong> <%= sessionExpires || '60' %> секунд</small>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

    <!-- Футер -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h4 class="logo-font mb-3">
                        <i class="fas fa-rose"></i> Flowers by Sabi
                    </h4>
                    <p>Лучшие цветы для ваших самых важных моментов. Мы создаем красоту с 2024 года.</p>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-vk"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                        <a href="#"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                
                <div class="col-md-4 mb-4">
                    <h5>Контакты</h5>
                    <ul class="list-unstyled">
                        <% if (shopInfo) { %>
                            <li><i class="fas fa-phone me-2"></i> <%= shopInfo.phone %></li>
                            <li><i class="fas fa-envelope me-2"></i> <%= shopInfo.email %></li>
                            <li><i class="fas fa-map-marker-alt me-2"></i> <%= shopInfo.address %></li>
                        <% } else { %>
                            <li><i class="fas fa-phone me-2"></i> +7 (999) 123-45-67</li>
                            <li><i class="fas fa-envelope me-2"></i> info@flowersbysabi.ru</li>
                            <li><i class="fas fa-map-marker-alt me-2"></i> г. Москва, ул. Цветочная, 1</li>
                        <% } %>
                    </ul>
                </div>
                
                <div class="col-md-4 mb-4">
                    <h5>Часы работы</h5>
                    <ul class="list-unstyled">
                        <li>Пн-Пт: 9:00 - 21:00</li>
                        <li>Сб-Вс: 10:00 - 20:00</li>
                        <li>Доставка: круглосуточно</li>
                    </ul>
                </div>
            </div>
            
            <hr class="my-4" style="border-color: rgba(255,255,255,0.1);">
            
            <div class="text-center">
                <p class="mb-0">
                    © 2024 Flowers by Sabi. Все права защищены.
                    <% if (sessionCounter) { %>
                        <small class="d-block text-muted mt-1">Сессия: <%= sessionCounter %> запросов</small>
                    <% } %>
                </p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS и зависимости -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Пользовательский JS -->
    <script>
        // Автоматическое скрытие уведомлений через 5 секунд
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert:not(.alert-permanent)');
                alerts.forEach(function(alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
        
        // Обновление счетчика корзины (если используется AJAX)
        function updateCartCount(count) {
            const badge = document.querySelector('.cart-badge');
            if (badge) {
                badge.textContent = count;
                badge.style.display = count > 0 ? 'block' : 'none';
            }
        }
    </script>
</body>
</html>