<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpMEjIs+RU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjYkKHwwNw==" crossorigin="anonymous">
    
    <!-- Свои стили -->
    <link rel="stylesheet" href="/stylesheets/style.css">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            padding-top: 70px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar-brand {
            font-weight: 600;
        }
        .footer {
            margin-top: 50px;
        }
        .card {
            transition: transform 0.3s;
            border: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }
        .hero-section {
            background: linear-gradient(rgba(220, 53, 69, 0.9), rgba(220, 53, 69, 0.7)), url('/images/hero-bg.jpg');
            background-size: cover;
            color: white;
            padding: 80px 0;
            margin-bottom: 40px;
            border-radius: 0 0 20px 20px;
        }
    </style>
</head>
<body>
    <!-- Навигационное меню -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-flower1"></i> Магазин цветов "Flowers by Sabi"
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= (title.includes('Главная') ? 'active' : '') %>" href="/">
                            <i class="bi bi-house-door"></i> Главная
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (title.includes('Розы') ? 'active' : '') %>" href="/roses">
                            <i class="bi bi-rose"></i> Розы
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (title.includes('Свадебные') ? 'active' : '') %>" href="/wedding">
                            <i class="bi bi-hearts"></i> Свадебные цветы
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= (title.includes('Экзотические') || title.includes('Необычные')) ? 'active' : '' %>" href="/unusual">
                            <i class="bi bi-flower3"></i> Экзотические цветы
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-collection"></i> Коллекции
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/flower/rose">Красная роза</a></li>
                            <li><a class="dropdown-item" href="/flower/exotic">Экзотический цветок</a></li>
                            <li><a class="dropdown-item" href="/flower/wedding">Свадебная композиция</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">Все цветы</a></li>
                        </ul>
                    </li>
                </ul>
                
                <div class="d-flex">
                    <a href="#" class="btn btn-outline-light me-2">
                        <i class="bi bi-cart3"></i> Корзина
                    </a>
                    <a href="#" class="btn btn-light">
                        <i class="bi bi-telephone"></i> Заказать
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Основное содержимое -->
    <main class="container">
        <%- body %>
    </main>

    <!-- Футер -->
    <footer class="footer bg-dark text-white py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="bi bi-flower1"></i> Магазин цветов "Flowers by Sabi"</h5>
                    <p>Красота, что цветёт</p>
                    <div class="social-links">
                        <a href="#" class="text-white me-3"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-whatsapp"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-telegram"></i></a>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <h5>Контакты</h5>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-geo-alt"></i> г. Симферополь, ул. Цветочная, д. 1</li>
                        <li><i class="bi bi-telephone"></i> +7 (979) 001-76-10</li>
                        <li><i class="bi bi-envelope"></i> sabi.abibulaeva@mail.ru</li>
                        <li><i class="bi bi-clock"></i> Ежедневно с 10:00 до 20:00</li>
                    </ul>
                </div>
                
                <div class="col-md-4">
                    <h5>Быстрые ссылки</h5>
                    <ul class="list-unstyled">
                        <li><a href="/roses" class="text-white text-decoration-none">Розы</a></li>
                        <li><a href="/wedding" class="text-white text-decoration-none">Свадебные букеты</a></li>
                        <li><a href="/unusual" class="text-white text-decoration-none">Экзотические цветы</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Доставка и оплата</a></li>
                        <li><a href="#" class="text-white text-decoration-none">О нас</a></li>
                    </ul>
                </div>
            </div>
            
            <hr class="bg-secondary">
            
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; 2026 Магазин цветов "Flowers by Sabi". Все права защищены.</p>
                </div>
                <div class="col-md-6 text-end">
                    <p>Сделано с <i class="bi bi-heart-fill text-danger"></i> для любителей цветов</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3PEjIs+RU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjYkKHwwNw==" crossorigin="anonymous"></script>
    
    <!-- Свои скрипты -->
    <script>
        // Активация активной ссылки в навигации
        document.addEventListener('DOMContentLoaded', function() {
            const currentPage = '<%= title %>';
            console.log('Текущая страница:', currentPage);
        });
        
        // Тултипы
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
</body>
</html>