    }
    
    .sabi-input-group-text {
        background: var(--sabi-light-pink);
        border: 2px solid #ffe4e9;
        border-right: none;
        color: var(--sabi-pink);
    }
    
    .sabi-form-select {
        background: var(--sabi-light-pink);
        border: 2px solid #ffe4e9;
        border-radius: 15px;
        color: var(--sabi-brown);
