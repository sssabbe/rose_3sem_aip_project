    .sabi-btn-favorite {
        background: var(--sabi-light-pink);
        color: var(--sabi-pink);
        border: 1px solid #ffe4e9;
        border-radius: 50%;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    
    .sabi-btn-favorite:hover {
        background: var(--sabi-pink);
        color: white;
    }
    
    .sabi-btn-favorite.active {
        background: var(--sabi-pink);
        color: white;
    }
    
    .sabi-counter {
        text-align: center;
        color: var(--sabi-dusty-rose);
        font-style: italic;
        padding: 1rem;
        background: var(--sabi-light-pink);
        border-radius: 15px;
    }
    
    .counter-text {
        font-size: 1.1rem;
    }
    
    .counter-text span {
        font-weight: bold;
        color: var(--sabi-pink);
    }
    
    .sabi-modal .modal-content {
        border-radius: 20px;
        border: 2px solid var(--sabi-rose);
