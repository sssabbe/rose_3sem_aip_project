        background: var(--sabi-light-pink);
        border-radius: 15px;
    }
    
    .detail-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--sabi-dusty-rose);
        font-size: 0.9rem;
    }
    
    .detail-item i {
        color: var(--sabi-pink);
        width: 16px;
    }
    
    .sabi-bouquet-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .sabi-bouquet-price {
        display: flex;
        flex-direction: column;
    }
    
    .price-current {
        font-size: 1.6rem;
        color: var(--sabi-pink);
        font-weight: bold;
    }
    
    .price-old {
        font-size: 1rem;
        color: #999;
        text-decoration: line-through;
    }
    
    .price-per-unit {
        font-size: 0.8rem;
        color: var(--sabi-dusty-rose);
    }
    
    .sabi-bouquet-form {
        flex-shrink: 0;
    }
    
    .sabi-btn-cart {
        background: linear-gradient(135deg, var(--sabi-pink), var(--sabi-rose));
        color: white;
        border: none;
        border-radius: 50%;
