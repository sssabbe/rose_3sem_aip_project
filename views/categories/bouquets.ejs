<div class="container py-5">
    <!-- Хлебные крошки -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb sabi-breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="sabi-link">
                    <i class="fas fa-home"></i> Главная
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/categories" class="sabi-link">
                    <i class="fas fa-list"></i> Категории
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-bouquet"></i> Букеты
            </li>
        </ol>
    </nav>

    <!-- Заголовок страницы -->
    <div class="sabi-page-header mb-5">
        <h1 class="sabi-page-title">
            <i class="fas fa-bouquet"></i> Букеты
        </h1>
        <p class="sabi-page-subtitle">
            Готовые цветочные композиции для любых поводов
        </p>
        <div class="sabi-page-decoration">
            <span>🌹</span>
            <span>🌸</span>
            <span>💐</span>
            <span>🌺</span>
            <span>🌷</span>
        </div>
    </div>

    <!-- Фильтры и сортировка -->
    <div class="sabi-filters mb-5">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="input-group sabi-search-group">
                    <span class="input-group-text sabi-input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" class="form-control sabi-form-control" placeholder="Поиск букетов..." id="bouquetSearch">
                </div>
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end gap-3">
                    <select class="form-select sabi-form-select" id="sortBouquets">
                        <option selected>Сортировать по</option>
                        <option value="price-asc">Цена: по возрастанию</option>
                        <option value="price-desc">Цена: по убыванию</option>
                        <option value="name">По названию</option>
                        <option value="popular">По популярности</option>
                    </select>
                    <button class="btn sabi-btn-outline" onclick="resetFilters()">
                        <i class="fas fa-redo"></i> Сбросить
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Сетка букетов -->
    <% if (products && products.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="bouquetGrid">
            <% products.forEach((product, index) => { %>
                <div class="col">
                    <div class="sabi-bouquet-card" data-name="<%= product.name.toLowerCase() %>" 
                         data-price="<%= product.price %>" data-popularity="<%= index %>">
                        <!-- Изображение букета -->
                        <div class="sabi-bouquet-image">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid">
                            <% } else { %>
                                <div class="sabi-bouquet-image-placeholder">
                                    <i class="fas fa-bouquet fa-4x"></i>
                                </div>
                            <% } %>
                            
                            <!-- Бейджи -->
                            <div class="sabi-bouquet-badges">
                                <% if (product.isNew) { %>
                                    <span class="badge sabi-badge-new">Новинка</span>
                                <% } %>
                                <% if (product.discount) { %>
                                    <span class="badge sabi-badge-discount">-<%= product.discount %>%</span>
                                <% } %>
                                <% if (product.bestSeller) { %>
                                    <span class="badge sabi-badge-bestseller">Хит продаж</span>
                                <% } %>
                            </div>
                            
                            <!-- Быстрый просмотр -->
                            <div class="sabi-bouquet-overlay">
                                <button class="btn sabi-btn-quickview" onclick="quickView(<%= JSON.stringify(product).replace(/"/g, '&quot;') %>)">
                                    <i class="fas fa-eye"></i> Быстрый просмотр
                                </button>
                            </div>
                        </div>

                        <!-- Информация о букете -->
                        <div class="sabi-bouquet-info">
                            <h3 class="sabi-bouquet-title"><%= product.name %></h3>
                            <p class="sabi-bouquet-description"><%= product.description || 'Элегантная композиция из свежих цветов' %></p>
                            
                            <!-- Детали букета -->
                            <div class="sabi-bouquet-details">
                                <div class="detail-item">
                                    <i class="fas fa-palette"></i>
                                    <span><%= product.color || 'Разноцветный' %></span>
                                </div>
                                <div class="detail-item">
                                    <i class="fas fa-ruler-combined"></i>
                                    <span><%= product.size || 'Средний' %></span>
                                </div>
                                <div class="detail-item">
                                    <i class="fas fa-leaf"></i>
                                    <span><%= product.flowers || 'Розы, хризантемы' %></span>
                                </div>
                            </div>

                            <!-- Цена и действия -->
                            <div class="sabi-bouquet-footer">
                                <div class="sabi-bouquet-price">
                                    <% if (product.oldPrice) { %>
                                        <div class="price-old"><%= product.oldPrice %> ₽</div>
                                    <% } %>
                                    <div class="price-current"><%= product.price %> ₽</div>
                                    <% if (product.pricePerFlower) { %>
                                        <div class="price-per-unit"><%= product.pricePerFlower %> ₽/цветок</div>
                                    <% } %>
                                </div>

                                <!-- Форма добавления в корзину -->
                                <form action="/categories/cart/add" method="POST" class="sabi-bouquet-form">
                                    <input type="hidden" name="id" value="<%= product.id %>">
                                    <input type="hidden" name="name" value="<%= product.name %>">
                                    <input type="hidden" name="price" value="<%= product.price %>">
                                    <input type="hidden" name="image" value="<%= product.image || '' %>">
                                    <input type="hidden" name="category" value="bouquets">
                                    
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="quantity-selector">
                                            <button type="button" class="btn btn-quantity minus" onclick="changeQuantity(this, -1)">-</button>
                                            <input type="number" name="quantity" value="1" min="1" max="99" class="quantity-input" readonly>
                                            <button type="button" class="btn btn-quantity plus" onclick="changeQuantity(this, 1)">+</button>
                                        </div>
                                        
                                        <button type="submit" class="sabi-btn sabi-btn-cart">
                                            <i class="fas fa-cart-plus"></i>
                                        </button>
                                        
                                        <button type="button" class="btn sabi-btn-favorite" onclick="toggleFavorite(this)">
                                            <i class="far fa-heart"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <!-- Счетчик товаров -->
        <div class="sabi-counter mt-4">
            <span class="counter-text">Показано <span id="shownCount"><%= products.length %></span> из <span id="totalCount"><%= products.length %></span> букетов</span>
        </div>
    <% } else { %>
        <!-- Сообщение об отсутствии букетов -->
        <div class="sabi-empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-bouquet fa-3x"></i>
            </div>
            <h3 class="empty-state-title">Букеты скоро появятся!</h3>
            <p class="empty-state-text">
                Мы готовим для вас прекрасные цветочные композиции. 
                Скоро здесь будут новые букеты для любого повода!
            </p>
            <div class="empty-state-actions">
                <a href="/categories" class="sabi-btn sabi-btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> К другим категориям
                </a>
                <a href="/" class="sabi-btn">
                    <i class="fas fa-home me-2"></i> На главную
                </a>
            </div>
        </div>
    <% } %>
    
    <!-- Кнопка возврата -->
    <div class="text-center mt-5">
        <a href="/categories" class="sabi-btn sabi-btn-outline">
            <i class="fas fa-arrow-left me-2"></i> Назад к категориям
        </a>
    </div>
</div>

<!-- Модальное окно быстрого просмотра -->
<div class="modal fade" id="quickViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content sabi-modal">
            <div class="modal-header">
                <h5 class="modal-title">Быстрый просмотр</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="quickViewContent">
                <!-- Контент загружается через JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- Стили для страницы букетов -->
