    }
    
    .sabi-bouquet-card:hover .sabi-bouquet-overlay {
        opacity: 1;
    }
    
    .sabi-btn-quickview {
        background: white;
        color: var(--sabi-pink);
        border: none;
        border-radius: 25px;
        padding: 10px 20px;
        font-weight: bold;
        transition: all 0.3s ease;
    }
    
    .sabi-btn-quickview:hover {
        background: var(--sabi-light-pink);
        transform: scale(1.05);
    }
    
    .sabi-bouquet-info {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    
    .sabi-bouquet-title {
        font-family: 'Georgia', serif;
        font-size: 1.4rem;
        color: var(--sabi-brown);
        margin-bottom: 0.8rem;
        font-weight: bold;
    }
    
    .sabi-bouquet-description {
