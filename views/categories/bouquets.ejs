    }
    
    .sabi-badge-discount {
        background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
        color: white;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
    }
    
    .sabi-badge-bestseller {
        background: linear-gradient(135deg, #ffd166, #ffde8a);
        color: #5a4a4a;
        padding: 5px 12px;
