        </div>
    </div>
</section>

<!-- Секция рассылки -->
<section class="sabi-newsletter-section">
    <div class="container">
        <div class="sabi-newsletter">
            <div class="newsletter-content">
                <h3><i class="fas fa-envelope"></i> Подпишитесь на рассылку</h3>
                <p>Получайте эксклюзивные предложения и новости о новинках первыми</p>
            </div>
            <div class="newsletter-form">
                <form action="/subscribe" method="POST" class="row g-2">
                    <div class="col-md-8">
                        <input type="email" 
                               class="form-control sabi-form-control" 
                               placeholder="Ваш email" 
                               name="email"
                               required>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="sabi-btn w-100">
                            <i class="fas fa-paper-plane me-2"></i> Подписаться
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Стили для главной страницы -->
<style>
    /* Герой-секция */
    .sabi-hero-section {
        background: linear-gradient(135deg, #fff5f5 0%, #ffe4e9 100%);
        padding: 5rem 0;
        position: relative;
        overflow: hidden;
    }
    
    .sabi-hero-section::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
            radial-gradient(circle at 10% 20%, rgba(255, 182, 193, 0.1) 0%, transparent 20%),
            radial-gradient(circle at 90% 80%, rgba(255, 182, 193, 0.1) 0%, transparent 20%);
        z-index: 1;
    }
    
    .sabi-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .sabi-hero-decoration {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
    }
    
    .sabi-hero-decoration span {
        position: absolute;
        font-size: 3rem;
        opacity: 0.3;
        animation: float 6s ease-in-out infinite;
    }
    
    .deco-1 { top: 10%; left: 5%; animation-delay: 0s; }
    .deco-2 { top: 20%; right: 10%; animation-delay: 1s; }
    .deco-3 { bottom: 30%; left: 15%; animation-delay: 2s; }
    .deco-4 { bottom: 20%; right: 20%; animation-delay: 3s; }
    .deco-5 { top: 50%; left: 50%; transform: translate(-50%, -50%); animation-delay: 4s; }
    
    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(0); }
        50% { transform: translateY(-20px) rotate(10deg); }
    }
    
    .sabi-hero-text {
        text-align: center;
        max-width: 800px;
        margin: 0 auto 3rem;
    }
    
    .sabi-hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 4rem;
        color: var(--sabi-pink);
        margin-bottom: 1rem;
    }
    
    .sabi-hero-subtitle {
        font-size: 1.8rem;
        color: var(--sabi-dusty-rose);
        margin-bottom: 1.5rem;
        font-weight: 300;
    }
    
    .sabi-hero-description {
        font-size: 1.2rem;
        color: var(--sabi-dusty-rose);
        max-width: 600px;
        margin: 0 auto 2rem;
        line-height: 1.6;
    }
    
    .sabi-hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }
    
    .sabi-btn-hero {
        background: linear-gradient(135deg, var(--sabi-pink), var(--sabi-rose));
        color: white;
        padding: 1rem 2.5rem;
        font-size: 1.2rem;
        border-radius: 30px;
        border: none;
        box-shadow: 0 10px 30px rgba(231, 84, 128, 0.3);
    }
    
    .sabi-btn-hero:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(231, 84, 128, 0.4);
        color: white;
    }
    
    .sabi-btn-hero-outline {
        background: transparent;
        color: var(--sabi-pink);
        border: 2px solid var(--sabi-pink);
        padding: 1rem 2.5rem;
        font-size: 1.2rem;
        border-radius: 30px;
    }
    
    .sabi-btn-hero-outline:hover {
        background: var(--sabi-pink);
        color: white;
    }
    
    /* Приветствие пользователя */
    .sabi-user-greeting {
        max-width: 500px;
        margin: 3rem auto 0;
    }
    
    .greeting-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 25px;
        padding: 2rem;
        box-shadow: 0 15px 40px rgba(255, 182, 193, 0.2);
        border: 1px solid #ffe4e9;
        backdrop-filter: blur(10px);
    }
    
    .greeting-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    
    .greeting-header i {
        font-size: 2.5rem;
        color: var(--sabi-pink);
    }
    
    .greeting-header h5 {
        color: var(--sabi-brown);
        margin: 0;
    }
    
    .greeting-text {
        color: var(--sabi-dusty-rose);
        margin-bottom: 1.5rem;
    }
    
    .greeting-stats {
        background: var(--sabi-light-pink);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }
    
    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 0.8rem;
    }
    
    .stat-item:last-child {
        margin-bottom: 0;
    }
    
    .stat-item i {
        color: var(--sabi-pink);
        width: 20px;
    }
    
    .stat-item span {
        color: var(--sabi-brown);
        font-size: 0.95rem;
    }
    
    .stat-item strong {
        color: var(--sabi-pink);
    }
    
    /* Секция преимуществ */
    .sabi-benefits-section {
        padding: 4rem 0;
        background: white;
    }
    
    .benefit-card {
        text-align: center;
        padding: 2rem 1rem;
        border-radius: 20px;
        transition: all 0.3s ease;
    }
    
    .benefit-card:hover {
        transform: translateY(-10px);
        background: var(--sabi-light-pink);
        box-shadow: 0 10px 30px rgba(255, 182, 193, 0.15);
    }
    
    .benefit-icon {
        font-size: 2.5rem;
        color: var(--sabi-pink);
        margin-bottom: 1rem;
    }
    
    .benefit-card h5 {
        color: var(--sabi-brown);
        margin-bottom: 0.5rem;
    }
    
    .benefit-card p {
        color: var(--sabi-dusty-rose);
        font-size: 0.9rem;
        margin: 0;
    }
    
    /* Заголовки секций */
    .sabi-section-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .sabi-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        color: var(--sabi-pink);
        margin-bottom: 1rem;
    }
    
    .sabi-section-subtitle {
        color: var(--sabi-dusty-rose);
        font-size: 1.2rem;
        max-width: 600px;
        margin: 0 auto;
    }
    
    /* Секция категорий */
    .sabi-categories-section {
        padding: 5rem 0;
        background: linear-gradient(135deg, #fff5f5 0%, #fff0f5 100%);
    }
    
    .sabi-category-card {
        display: block;
        background: white;
