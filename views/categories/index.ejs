<!-- views/index.ejs -->
<!-- Главная страница Flowers by Sabi -->

<!-- Герой-секция -->
<section class="sabi-hero-section">
    <div class="container">
        <div class="sabi-hero-content">
            <!-- Декоративные элементы -->
            <div class="sabi-hero-decoration">
                <span class="deco-1">🌹</span>
                <span class="deco-2">🌸</span>
                <span class="deco-3">🌺</span>
                <span class="deco-4">🌷</span>
                <span class="deco-5">💐</span>
            </div>
            
            <!-- Основной контент -->
            <div class="sabi-hero-text">
                <h1 class="sabi-hero-title">
                    <i class="fas fa-rose"></i> Flowers by Sabi
                </h1>
                <p class="sabi-hero-subtitle">
                    Нежные цветы для ваших особенных моментов
                </p>
                <p class="sabi-hero-description">
                    Каждый цветок — это история любви, застывшая в лепестках. 
                    Подарите себе или близким волшебство природы.
                </p>
                
                <!-- Кнопки призыва к действию -->
                <div class="sabi-hero-actions">
                    <a href="/categories" class="sabi-btn sabi-btn-hero">
                        <i class="fas fa-shopping-cart me-2"></i> Начать покупки
                    </a>
                    <a href="#categories" class="sabi-btn sabi-btn-hero-outline">
                        <i class="fas fa-eye me-2"></i> Посмотреть коллекцию
                    </a>
                </div>
            </div>
            
            <!-- Приветствие пользователя -->
            <div class="sabi-user-greeting">
                <div class="greeting-card">
                    <div class="greeting-header">
                        <i class="fas fa-user-circle"></i>
                        <h5>Добро пожаловать, <%= userName || 'дорогой гость' %>!</h5>
                    </div>
                    <div class="greeting-body">
                        <p class="greeting-text"><%= greeting %></p>
                        <div class="greeting-stats">
                            <div class="stat-item">
                                <i class="fas fa-history"></i>
                                <span>Вы посещали нас: <strong><%= visitCount %></strong> раз</span>
                            </div>
                            <div class="stat-item">
                                <i class="fas fa-calendar-check"></i>
                                <span>Последний визит: <strong><%= lastVisit %></strong></span>
                            </div>
                        </div>
                        
                        <!-- Форма для установки имени -->
                        <form action="/set-name" method="POST" class="greeting-form">
                            <div class="input-group">
                                <input type="text" 
                                       class="form-control sabi-form-control" 
                                       name="userName" 
                                       placeholder="Как к вам обращаться?"
                                       value="<%= userName || '' %>"
                                       required>
                                <button type="submit" class="btn sabi-btn">
                                    <i class="fas fa-user-check"></i>
                                </button>
                            </div>
                            <small class="form-text">Имя будет сохранено для персонализации</small>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Секция преимуществ -->
<section class="sabi-benefits-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <h5>Быстрая доставка</h5>
                    <p>По Москве за 2 часа, даже в праздники</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h5>Свежие цветы</h5>
                    <p>Ежедневные поставки от лучших плантаций</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <i class="fas fa-award"></i>
                    </div>
                    <h5>Премиум качество</h5>
                    <p>Отборные цветы с гарантией свежести</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h5>Поддержка 24/7</h5>
                    <p>Флористы помогут с выбором</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Секция категорий -->
<section id="categories" class="sabi-categories-section">
    <div class="container">
        <div class="sabi-section-header">
            <h2 class="sabi-section-title">
                <i class="fas fa-gem"></i> Наши коллекции
            </h2>
            <p class="sabi-section-subtitle">
                Выберите идеальный подарок из наших категорий
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            <!-- Категория 1: Букеты -->
            <div class="col">
                <a href="/categories/bouquets" class="sabi-category-card">
                    <div class="category-image" style="background: linear-gradient(135deg, #ff9ebb, #e75480);">
                        <i class="fas fa-bouquet"></i>
                    </div>
                    <div class="category-content">
                        <h3>Букеты</h3>
                        <p>Готовые композиции для любого повода</p>
                        <span class="category-link">
                            Смотреть коллекцию <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <!-- Категория 2: Цветы -->
            <div class="col">
                <a href="/categories/flowers" class="sabi-category-card">
                    <div class="category-image" style="background: linear-gradient(135deg, #ffd166, #ffde8a);">
                        <i class="fas fa-spa"></i>
                    </div>
                    <div class="category-content">
                        <h3>Цветы</h3>
                        <p>Срезанные цветы для составления букета</p>
                        <span class="category-link">
                            Смотреть коллекцию <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <!-- Категория 3: Аксессуары -->
            <div class="col">
                <a href="/categories/accessories" class="sabi-category-card">
                    <div class="category-image" style="background: linear-gradient(135deg, #a8e6cf, #6aecd8);">
                        <i class="fas fa-ribbon"></i>
                    </div>
                    <div class="category-content">
                        <h3>Аксессуары</h3>
                        <p>Дополнения для идеального подарка</p>
                        <span class="category-link">
                            Смотреть коллекцию <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <!-- Категория 4: Подарки -->
            <div class="col">
                <a href="/categories/gifts" class="sabi-category-card">
                    <div class="category-image" style="background: linear-gradient(135deg, #b8b3e9, #d8b4fe);">
                        <i class="fas fa-gift"></i>
                    </div>
                    <div class="category-content">
                        <h3>Подарки</h3>
                        <p>Сладкие дополнения к цветам</p>
                        <span class="category-link">
                            Смотреть коллекцию <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Секция хитов продаж -->
<section class="sabi-featured-section">
    <div class="container">
        <div class="sabi-section-header">
            <h2 class="sabi-section-title">
                <i class="fas fa-crown"></i> Хиты продаж
            </h2>
            <p class="sabi-section-subtitle">
                Самые популярные товары среди наших клиентов
            </p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <!-- Товар 1 -->
            <div class="col">
                <div class="sabi-featured-card">
                    <div class="featured-badge">ХИТ</div>
                    <div class="featured-image">
                        <div class="image-placeholder" style="background: linear-gradient(135deg, #ff9ebb, #e75480);">
                            <i class="fas fa-heart"></i>
                        </div>
                    </div>
                    <div class="featured-content">
                        <h3>Алая страсть</h3>
                        <p>Классическая красная роза с бархатными лепестками</p>
                        <div class="featured-price">
                            <span class="price-current">650 ₽</span>
                            <span class="price-old">750 ₽</span>
                        </div>
                        <form action="/categories/cart/add" method="POST" class="featured-form">
                            <input type="hidden" name="id" value="rose1">
                            <input type="hidden" name="name" value="Алая страсть">
                            <input type="hidden" name="price" value="650">
                            <button type="submit" class="sabi-btn sabi-btn-sm">
                                <i class="fas fa-cart-plus me-2"></i> В корзину
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Товар 2 -->
            <div class="col">
                <div class="sabi-featured-card">
                    <div class="featured-badge">НОВИНКА</div>
                    <div class="featured-image">
                        <div class="image-placeholder" style="background: linear-gradient(135deg, #ffd166, #ffde8a);">
                            <i class="fas fa-star"></i>
                        </div>
                    </div>
                    <div class="featured-content">
                        <h3>Розовая мечта</h3>
                        <p>Нежно-розовые бутоны с тонким ароматом</p>
                        <div class="featured-price">
                            <span class="price-current">550 ₽</span>
                            <span class="price-old">700 ₽</span>
                        </div>
                        <form action="/categories/cart/add" method="POST" class="featured-form">
                            <input type="hidden" name="id" value="rose2">
                            <input type="hidden" name="name" value="Розовая мечта">
                            <input type="hidden" name="price" value="550">
                            <button type="submit" class="sabi-btn sabi-btn-sm">
                                <i class="fas fa-cart-plus me-2"></i> В корзину
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Товар 3 -->
            <div class="col">
                <div class="sabi-featured-card">
                    <div class="featured-badge">ЭКСКЛЮЗИВ</div>
                    <div class="featured-image">
                        <div class="image-placeholder" style="background: linear-gradient(135deg, #a8e6cf, #6aecd8);">
                            <i class="fas fa-crown"></i>
                        </div>
                    </div>
                    <div class="featured-content">
                        <h3>Белая королева</h3>
                        <p>Белоснежные лепестки с изысканной формой</p>
                        <div class="featured-price">
                            <span class="price-current">700 ₽</span>
                            <span class="price-old">800 ₽</span>
                        </div>
                        <form action="/categories/cart/add" method="POST" class="featured-form">
                            <input type="hidden" name="id" value="rose3">
                            <input type="hidden" name="name" value="Белая королева">
                            <input type="hidden" name="price" value="700">
                            <button type="submit" class="sabi-btn sabi-btn-sm">
                                <i class="fas fa-cart-plus me-2"></i> В корзину
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Секция отзывов -->
