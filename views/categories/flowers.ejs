    }
    
    .freshness-label {
        font-size: 0.7rem;
        color: var(--sabi-dusty-rose);
    }
    
    .sabi-flower-color {
        position: absolute;
        top: 10px;
        right: 10px;
        background: var(--sabi-pink);
        color: white;
        padding: 3px 10px;
        border-radius: 15px;
