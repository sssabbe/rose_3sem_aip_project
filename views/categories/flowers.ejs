<!-- views/categories/flowers.ejs -->
<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Главная</a></li>
            <li class="breadcrumb-item"><a href="/categories">Категории</a></li>
            <li class="breadcrumb-item active" aria-current="page">Цветы</li>
        </ol>
    </nav>

    <h1 class="mb-4">🌸 Срезанные цветы</h1>
    <p class="lead mb-5">Выберите отдельные цветы для составления идеального букета</p>
    
    <% if (products && products.length > 0) { %>
        <div class="row">
            <% products.forEach(product => { %>
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="fas fa-flower fa-4x text-success"></i>
                        </div>
                        <h5 class="card-title"><%= product.name %></h5>
                        <p class="card-text"><%= product.description %></p>
                        <div class="mt-3">
                            <span class="h4 text-success d-block mb-2"><%= product.price %> ₽</span>
                            <button class="btn btn-outline-success btn-sm">
                                <i class="fas fa-plus"></i> Добавить
                            </button>
                            <a href="/flowers/<%= product._id %>" class="btn btn-link btn-sm">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="alert alert-info">
            <i class="fas fa-seedling me-2"></i>
            Цветы скоро появятся в нашем ассортименте!
        </div>
    <% } %>
    
    <div class="mt-4">
        <a href="/categories" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Назад к категориям
        </a>
    </div>
</div>