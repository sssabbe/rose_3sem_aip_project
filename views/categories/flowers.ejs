        background: rgba(255, 255, 255, 0.9);
        padding: 5px 10px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        gap: 5px;
        backdrop-filter: blur(5px);
    }
    
    .freshness-bar {
        display: flex;
        gap: 2px;
    }
    
    .freshness-dot {
        width: 6px;
