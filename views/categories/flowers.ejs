        display: flex;
        flex-direction: column;
    }
    
    .sabi-flower-header {
        margin-bottom: 1rem;
    }
    
    .sabi-flower-title {
        color: var(--sabi-brown);
        font-size: 1.3rem;
        margin-bottom: 0.2rem;
    }
    
    .sabi-flower-latin {
        color: var(--sabi-dusty-rose);
        font-style: italic;
        font-size: 0.8rem;
    }
    
    .sabi-flower-description {
        color: var(--sabi-dusty-rose);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        flex-grow: 1;
    }
    
    .sabi-flower-specs {
        display: flex;
        justify-content: space-between;
