<div class="container py-5">
    <!-- Хлебные крошки -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb sabi-breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="sabi-link">
                    <i class="fas fa-home"></i> Главная
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/categories" class="sabi-link">
                    <i class="fas fa-list"></i> Категории
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-spa"></i> Цветы
            </li>
        </ol>
    </nav>

    <!-- Заголовок страницы -->
    <div class="sabi-page-header mb-5">
        <h1 class="sabi-page-title">
            <i class="fas fa-spa"></i> Срезанные цветы
        </h1>
        <p class="sabi-page-subtitle">
            Отдельные цветы для составления идеального букета
        </p>
        <div class="sabi-page-decoration">
            <i class="fas fa-seedling"></i>
            <i class="fas fa-leaf"></i>
            <i class="fas fa-flower"></i>
            <i class="fas fa-feather-alt"></i>
            <i class="fas fa-star-of-life"></i>
        </div>
    </div>

    <!-- Фильтры цветов -->
    <div class="sabi-filters mb-5">
        <div class="row align-items-center">
            <div class="col-md-4">
                <div class="sabi-form-group">
                    <label class="sabi-form-label mb-2">
                        <i class="fas fa-filter"></i> Тип цветов
                    </label>
                    <div class="sabi-filter-buttons">
                        <button class="btn sabi-filter-btn active" data-filter="all">Все</button>
                        <button class="btn sabi-filter-btn" data-filter="roses">Розы</button>
                        <button class="btn sabi-filter-btn" data-filter="tulips">Тюльпаны</button>
                        <button class="btn sabi-filter-btn" data-filter="lilies">Лилии</button>
                        <button class="btn sabi-filter-btn" data-filter="seasonal">Сезонные</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="sabi-form-group">
                    <label class="sabi-form-label mb-2">
                        <i class="fas fa-sort-amount-down"></i> Сортировка
                    </label>
                    <select class="form-select sabi-form-select" id="sortFlowers">
                        <option value="popular">По популярности</option>
                        <option value="price-asc">Цена: по возрастанию</option>
                        <option value="price-desc">Цена: по убыванию</option>
                        <option value="name">По названию</option>
                        <option value="freshness">По свежести</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="sabi-form-group">
                    <label class="sabi-form-label mb-2">
                        <i class="fas fa-search"></i> Поиск цветов
                    </label>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control sabi-form-control" 
                               placeholder="Название цветка..."
                               id="flowerSearch">
                        <button class="btn sabi-btn-outline" onclick="clearSearch()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Информационная панель -->
    <div class="sabi-info-panel mb-4">
        <div class="row">
            <div class="col-md-3 col-6">
                <div class="info-item">
                    <i class="fas fa-truck text-primary"></i>
                    <div>
                        <strong>Свежие поставки</strong>
                        <small>Ежедневно</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-item">
                    <i class="fas fa-award text-success"></i>
                    <div>
                        <strong>Премиум качество</strong>
                        <small>Отборные цветы</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-item">
                    <i class="fas fa-temperature-low text-info"></i>
                    <div>
                        <strong>Правильное хранение</strong>
                        <small>+2...+5°C</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-item">
                    <i class="fas fa-heart text-danger"></i>
                    <div>
                        <strong>Долгое цветение</strong>
                        <small>Гарантия свежести</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Сетка цветов -->
    <% if (products && products.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="flowerGrid">
            <% products.forEach((product, index) => { %>
                <div class="col" data-category="<%= product.category || 'roses' %>" 
                     data-name="<%= product.name.toLowerCase() %>">
                    <div class="sabi-flower-card">
                        <!-- Изображение цветка -->
                        <div class="sabi-flower-image">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid">
                            <% } else { %>
                                <div class="sabi-flower-icon" style="color: <%= product.color || '#e75480' %>">
                                    <i class="fas fa-flower fa-4x"></i>
                                </div>
                            <% } %>
                            
                            <!-- Индикатор свежести -->
                            <div class="sabi-freshness-indicator" 
                                 data-freshness="<%= product.freshness || 5 %>">
                                <div class="freshness-bar">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <div class="freshness-dot <%= i <= (product.freshness || 5) ? 'active' : '' %>"></div>
                                    <% } %>
                                </div>
                                <span class="freshness-label">Свежесть</span>
                            </div>
                            
                            <!-- Цвет цветка -->
                            <div class="sabi-flower-color" style="background-color: <%= product.color || '#e75480' %>">
                                <%= product.colorName || 'Розовый' %>
                            </div>
                        </div>

                        <!-- Информация о цветке -->
                        <div class="sabi-flower-info">
                            <div class="sabi-flower-header">
                                <h5 class="sabi-flower-title"><%= product.name %></h5>
                                <span class="sabi-flower-latin"><%= product.latin || 'Rosa spp.' %></span>
                            </div>
                            
                            <p class="sabi-flower-description">
                                <%= product.description || 'Прекрасный свежий цветок' %>
                            </p>
                            
                            <!-- Характеристики -->
                            <div class="sabi-flower-specs">
                                <div class="spec-item">
                                    <i class="fas fa-ruler-vertical"></i>
                                    <span><%= product.height || '40-50' %> см</span>
                                </div>
                                <div class="spec-item">
                                    <i class="fas fa-calendar-alt"></i>
                                    <span><%= product.blooming || '7-10' %> дней</span>
                                </div>
                                <div class="spec-item">
                                    <i class="fas fa-wind"></i>
                                    <span><%= product.scent || 'Легкий' %></span>
                                </div>
                            </div>

                            <!-- Цена и действия -->
                            <div class="sabi-flower-footer">
                                <div class="sabi-flower-price">
                                    <span class="price-current"><%= product.price %> ₽</span>
                                    <span class="price-per">/шт.</span>
                                    <% if (product.pricePer10) { %>
                                        <span class="price-bulk">
                                            <i class="fas fa-box"></i> <%= product.pricePer10 %> ₽ за 10 шт.
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Форма добавления в корзину -->
                                <form action="/categories/cart/add" method="POST" class="sabi-flower-form">
                                    <input type="hidden" name="id" value="<%= product.id %>">
                                    <input type="hidden" name="name" value="<%= product.name %>">
                                    <input type="hidden" name="price" value="<%= product.price %>">
                                    <input type="hidden" name="image" value="<%= product.image || '' %>">
                                    <input type="hidden" name="category" value="flowers">
                                    
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="quantity-selector">
                                            <button type="button" class="btn btn-quantity minus" onclick="changeQuantity(this, -1)">-</button>
                                            <input type="number" name="quantity" value="1" min="1" max="50" class="quantity-input" readonly>
                                            <button type="button" class="btn btn-quantity plus" onclick="changeQuantity(this, 1)">+</button>
                                        </div>
                                        
                                        <button type="submit" class="sabi-btn sabi-btn-cart">
                                            <i class="fas fa-cart-plus"></i>
                                        </button>
                                        
                                        <button type="button" class="btn sabi-btn-compare" onclick="toggleCompare(this, '<%= product.id %>')"
                                                title="Сравнить">
                                            <i class="fas fa-balance-scale"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <!-- Информация о выборе -->
        <div class="sabi-selection-info mt-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <p class="mb-0">
                        <i class="fas fa-lightbulb text-warning me-2"></i>
                        <strong>Совет:</strong> Для букета среднего размера рекомендуется 15-20 цветов.
                        <a href="#" class="sabi-link ms-2" data-bs-toggle="modal" data-bs-target="#bouquetGuide">
                            <i class="fas fa-question-circle"></i> Как составить букет?
                        </a>
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="sabi-selection-counter">
                        <span id="shownFlowers"><%= products.length %></span> из 
                        <span id="totalFlowers"><%= products.length %></span> цветов
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <!-- Сообщение об отсутствии цветов -->
        <div class="sabi-empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-seedling fa-3x"></i>
            </div>
            <h3 class="empty-state-title">Цветы скоро расцветут!</h3>
            <p class="empty-state-text">
                Наши цветы ещё набираются сил. Скоро здесь появятся свежие и красивые цветы для ваших букетов.
            </p>
            <div class="empty-state-actions">
                <a href="/categories/bouquets" class="sabi-btn">
                    <i class="fas fa-bouquet me-2"></i> Посмотреть букеты
                </a>
                <a href="/categories" class="sabi-btn sabi-btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> К другим категориям
                </a>
            </div>
        </div>
    <% } %>
    
    <!-- Кнопка возврата -->
    <div class="text-center mt-5">
        <a href="/categories" class="sabi-btn sabi-btn-outline">
            <i class="fas fa-arrow-left me-2"></i> Назад к категориям
        </a>
    </div>
</div>

<!-- Модальное окно руководства по букетам -->
<div class="modal fade" id="bouquetGuide" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content sabi-modal">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-book me-2"></i>Как составить идеальный букет
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6><i class="fas fa-check-circle text-success me-2"></i>Рекомендации:</h6>
                        <ul class="sabi-list">
                            <li>15-20 цветов для среднего букета</li>
                            <li>Сочетайте разные виды и цвета</li>
                            <li>Добавляйте зелень для объема</li>
                            <li>Учитывайте повод и предпочтения</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="fas fa-star text-warning me-2"></i>Популярные сочетания:</h6>
                        <ul class="sabi-list">
                            <li>Розы + гипсофила</li>
                            <li>Тюльпаны + ирисы</li>
                            <li>Лилии + альстромерии</li>
                            <li>Хризантемы + ромашки</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Стили для страницы цветов -->
