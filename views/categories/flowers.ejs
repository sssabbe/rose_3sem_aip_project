        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    .sabi-filter-btn {
        background: var(--sabi-light-pink);
        border: 1px solid #ffe4e9;
        color: var(--sabi-dusty-rose);
        border-radius: 20px;
        padding: 0.5rem 1rem;
        transition: all 0.3s ease;
    }
    
    .sabi-filter-btn:hover,
    .sabi-filter-btn.active {
        background: var(--sabi-pink);
        color: white;
        transform: translateY(-2px);
    }
    
    .sabi-info-panel {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 5px 15px rgba(255, 182, 193, 0.1);
        border: 1px solid #ffe4e9;
    }
    
    .info-item {
        display: flex;
        align-items: center;
