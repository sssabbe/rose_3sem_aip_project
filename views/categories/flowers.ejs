</style>

<script>
    // Управление количеством
    function changeQuantity(button, change) {
        const input = button.closest('.quantity-selector').querySelector('.quantity-input');
        let value = parseInt(input.value) + change;
        
        if (value < 1) value = 1;
        if (value > 50) value = 50;
        
        input.value = value;
    }
    
    // Сравнение цветов
    function toggleCompare(button, productId) {
        button.classList.toggle('active');
        const icon = button.querySelector('i');
        
        if (button.classList.contains('active')) {
            // Добавляем к сравнению
            let compareList = JSON.parse(localStorage.getItem('sabi_compare') || '[]');
            if (!compareList.includes(productId)) {
                compareList.push(productId);
                localStorage.setItem('sabi_compare', JSON.stringify(compareList));
            }
            showNotification('Цветок добавлен к сравнению');
        } else {
            // Удаляем из сравнения
            let compareList = JSON.parse(localStorage.getItem('sabi_compare') || '[]');
            compareList = compareList.filter(id => id !== productId);
            localStorage.setItem('sabi_compare', JSON.stringify(compareList));
            showNotification('Цветок удален из сравнения');
        }
    }
    
    // Фильтрация по типу
    document.querySelectorAll('.sabi-filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            // Активная кнопка
            document.querySelectorAll('.sabi-filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.dataset.filter;
            const flowers = document.querySelectorAll('#flowerGrid .col');
            let shownCount = 0;
            
            flowers.forEach(flower => {
                const category = flower.dataset.category;
                const isVisible = filter === 'all' || category === filter;
                flower.style.display = isVisible ? '' : 'none';
                if (isVisible) shownCount++;
            });
            
            document.getElementById('shownFlowers').textContent = shownCount;
        });
    });
    
    // Поиск цветов
    document.getElementById('flowerSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const flowers = document.querySelectorAll('#flowerGrid .col');
        let shownCount = 0;
        
        flowers.forEach(flower => {
            const name = flower.dataset.name;
            const isVisible = name.includes(searchTerm);
            flower.style.display = isVisible ? '' : 'none';
            if (isVisible) shownCount++;
        });
        
        document.getElementById('shownFlowers').textContent = shownCount;
    });
    
    // Очистка поиска
    function clearSearch() {
        document.getElementById('flowerSearch').value = '';
        document.querySelectorAll('#flowerGrid .col').forEach(flower => {
            flower.style.display = '';
        });
        document.getElementById('shownFlowers').textContent = 
            document.querySelectorAll('#flowerGrid .col').length;
    }
    
    // Сортировка
    document.getElementById('sortFlowers').addEventListener('change', function(e) {
        const sortBy = e.target.value;
        const container = document.getElementById('flowerGrid');
        const flowers = Array.from(container.querySelectorAll('.col'));
        
        // В реальном приложении здесь будет сортировка на сервере
        // Для демонстрации просто перемешиваем
        if (sortBy === 'random') {
            flowers.sort(() => Math.random() - 0.5);
            flowers.forEach(flower => container.appendChild(flower));
        }
    });
    
    // Анимация добавления в корзину
    document.querySelectorAll('.sabi-flower-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const productName = this.querySelector('input[name="name"]').value;
            const quantity = this.querySelector('.quantity-input').value;
            
            showNotification(`${quantity} шт. "${productName}" добавлен${quantity > 1 ? 'о' : ''} в корзину! 🌸`);
            
            setTimeout(() => {
                this.submit();
            }, 500);
        });
    });
    
    // Анимация появления цветов
    document.addEventListener('DOMContentLoaded', function() {
        const flowers = document.querySelectorAll('.sabi-flower-card');
        flowers.forEach((flower, index) => {
            flower.style.opacity = '0';
            flower.style.transform = 'translateY(30px) rotate(-2deg)';
            
            setTimeout(() => {
                flower.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                flower.style.opacity = '1';
                flower.style.transform = 'translateY(0) rotate(0)';
            }, index * 100);
        });
        
        // Устанавливаем индекс для анимации
        document.querySelectorAll('.sabi-page-decoration i').forEach((icon, i) => {
            icon.style.setProperty('--i', i);
        });
    });
    
    // Функция уведомлений
    function showNotification(message) {
        const notification = document.createElement('div');
        notification.className = 'sabi-notification';
        notification.innerHTML = `
            <div class="notification-content">
                <i class="fas fa-check-circle"></i>
                <span>${message}</span>
            </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.classList.add('show');
        }, 10);
        
        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                notification.remove();
            }, 300);
        }, 3000);
    }
</script>