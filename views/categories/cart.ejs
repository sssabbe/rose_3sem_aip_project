<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Главная</a></li>
            <li class="breadcrumb-item"><a href="/categories">Категории</a></li>
            <li class="breadcrumb-item active" aria-current="page">Корзина</li>
        </ol>
    </nav>

    <h1 class="mb-4">🛒 Корзина покупок</h1>
    
    <% if (cart && cart.length > 0) { %>
        <div class="alert alert-success">
            В вашей корзине <strong><%= cart.length %></strong> товаров
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th>Цена</th>
                        <th>Добавлен</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                    <tr>
                        <td><%= item.name %></td>
                        <td class="text-success fw-bold"><%= item.price %> ₽</td>
                        <td class="text-muted"><small><%= item.addedAt %></small></td>
                    </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr class="table-active">
                        <th>ИТОГО:</th>
                        <th class="text-success"><%= total %> ₽</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
        
        <div class="d-flex justify-content-between mt-4">
            <form action="/categories/cart/clear" method="POST">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="fas fa-trash"></i> Очистить корзину
                </button>
            </form>
            <a href="/categories" class="btn btn-primary">
                <i class="fas fa-shopping-bag"></i> Продолжить покупки
            </a>
        </div>
    <% } else { %>
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-shopping-cart fa-4x mb-3 text-muted"></i>
            <h4>Корзина пуста</h4>
            <p>Добавьте товары из наших категорий!</p>
            <a href="/categories" class="btn btn-primary mt-2">
                <i class="fas fa-store"></i> Перейти к покупкам
            </a>
        </div>
    <% } %>
</div>