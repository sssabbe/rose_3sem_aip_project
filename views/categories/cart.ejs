<div class="container py-5">
    <!-- Хлебные крошки -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb sabi-breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="sabi-link">
                    <i class="fas fa-home"></i> Главная
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/categories" class="sabi-link">
                    <i class="fas fa-list"></i> Категории
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-shopping-cart"></i> Корзина
            </li>
        </ol>
    </nav>

    <!-- Заголовок страницы -->
    <div class="sabi-page-header mb-5">
        <h1 class="sabi-page-title">
            <i class="fas fa-shopping-cart"></i> Корзина покупок
        </h1>
        <p class="sabi-page-subtitle">
            Ваши выбранные товары готовы к оформлению
        </p>
    </div>

    <% if (cart && cart.length > 0) { %>
        <!-- Информация о корзине -->
        <div class="sabi-cart-summary mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="sabi-alert sabi-alert-success">
                        <i class="fas fa-check-circle me-2"></i>
                        В вашей корзине <strong class="sabi-highlight"><%= cart.length %></strong> 
                        <%= cart.length === 1 ? 'товар' : cart.length < 5 ? 'товара' : 'товаров' %>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <button class="btn sabi-btn-outline" onclick="continueShopping()">
                        <i class="fas fa-plus me-2"></i> Добавить ещё
                    </button>
                </div>
            </div>
        </div>

        <!-- Основной контент корзины -->
        <div class="row">
            <!-- Список товаров -->
            <div class="col-lg-8">
                <div class="sabi-cart-items">
                    <% cart.forEach((item, index) => { %>
                        <div class="sabi-cart-item" data-id="<%= item.id %>">
                            <div class="row align-items-center">
                                <!-- Изображение товара -->
                                <div class="col-md-2 col-3">
                                    <div class="sabi-cart-item-image">
                                        <% if (item.image) { %>
                                            <img src="<%= item.image %>" alt="<%= item.name %>" class="img-fluid rounded">
                                        <% } else { %>
                                            <div class="sabi-cart-item-placeholder">
                                                <i class="fas fa-gift"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Информация о товаре -->
                                <div class="col-md-5 col-6">
                                    <div class="sabi-cart-item-info">
                                        <h5 class="sabi-cart-item-title">
                                            <%= item.name %>
                                        </h5>
                                        <p class="sabi-cart-item-category text-muted">
                                            <i class="fas fa-tag me-1"></i>
                                            <%= item.category || 'Букеты' %>
                                        </p>
                                        <div class="sabi-cart-item-meta">
                                            <span class="badge sabi-badge-stock">
                                                <i class="fas fa-check me-1"></i> В наличии
                                            </span>
                                            <% if (item.freshness) { %>
                                                <span class="badge sabi-badge-fresh">
                                                    <i class="fas fa-leaf me-1"></i> <%= item.freshness %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Управление количеством -->
                                <div class="col-md-3 col-6">
                                    <div class="sabi-cart-item-quantity">
                                        <div class="input-group">
                                            <button class="btn btn-quantity minus" 
                                                    onclick="updateQuantity(<%= index %>, -1)">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <input type="number" 
                                                   class="form-control quantity-input text-center" 
                                                   value="<%= item.quantity || 1 %>" 
                                                   min="1" 
                                                   max="99"
                                                   onchange="updateQuantityInput(<%= index %>, this.value)"
                                                   readonly>
                                            <button class="btn btn-quantity plus" 
                                                    onclick="updateQuantity(<%= index %>, 1)">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Цена и удаление -->
                                <div class="col-md-2 col-6">
                                    <div class="sabi-cart-item-price">
                                        <div class="h5 mb-0 text-primary">
                                            <%= (item.price * (item.quantity || 1)).toLocaleString('ru-RU') %> ₽
                                        </div>
                                        <div class="text-muted small">
                                            <%= item.price %> ₽ за шт.
                                        </div>
                                    </div>
                                    <div class="sabi-cart-item-remove">
                                        <button class="btn btn-link text-danger" 
                                                onclick="removeItem(<%= index %>)"
                                                title="Удалить">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Дополнительные опции -->
                <div class="sabi-cart-options mt-4">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="sabi-form-group">
                                <label class="sabi-form-label">
                                    <i class="fas fa-comment-dots me-2"></i>Комментарий к заказу
                                </label>
                                <textarea class="form-control sabi-form-control" 
                                          rows="3" 
                                          placeholder="Ваши пожелания к заказу (доставка, упаковка и т.д.)"
                                          id="orderComment"></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sabi-form-group">
                                <label class="sabi-form-label">
                                    <i class="fas fa-gift me-2"></i>Подарочная упаковка
                                </label>
                                <select class="form-select sabi-form-select" id="giftWrap">
                                    <option value="0" selected>Без упаковки</option>
                                    <option value="200">Бумажная упаковка (+200 ₽)</option>
                                    <option value="500">Подарочная коробка (+500 ₽)</option>
                                    <option value="800">Люкс упаковка с лентой (+800 ₽)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Панель заказа -->
            <div class="col-lg-4">
                <div class="sabi-order-summary">
                    <div class="sabi-order-header">
                        <h4><i class="fas fa-receipt me-2"></i>Сводка заказа</h4>
                    </div>
                    
                    <div class="sabi-order-body">
                        <!-- Детали заказа -->
                        <div class="sabi-order-details">
                            <div class="order-row">
                                <span>Товары (<%= cart.length %>)</span>
                                <span id="subtotal"><%= total %> ₽</span>
                            </div>
                            <div class="order-row">
                                <span>Доставка</span>
                                <span id="deliveryCost">0 ₽</span>
                            </div>
                            <div class="order-row">
                                <span>Упаковка</span>
                                <span id="wrapCost">0 ₽</span>
                            </div>
                            <% if (discount > 0) { %>
                                <div class="order-row text-success">
                                    <span><i class="fas fa-percentage me-1"></i>Скидка</span>
                                    <span>-<%= discount %> ₽</span>
                                </div>
                            <% } %>
                        </div>

                        <!-- Итог -->
                        <div class="sabi-order-total">
                            <div class="total-row">
                                <strong>Итого</strong>
                                <strong id="totalCost"><%= total - discount %> ₽</strong>
                            </div>
                        </div>

                        <!-- Промокод -->
                        <div class="sabi-promocode mt-4">
                            <div class="input-group">
                                <input type="text" 
                                       class="form-control sabi-form-control" 
                                       placeholder="Промокод"
                                       id="promoCode">
                                <button class="btn sabi-btn-outline" onclick="applyPromoCode()">
                                    Применить
                                </button>
                            </div>
                            <div class="promo-message mt-2" id="promoMessage"></div>
                        </div>

                        <!-- Кнопки действий -->
                        <div class="sabi-order-actions mt-4">
                            <form action="/categories/cart/clear" method="POST" class="d-grid">
                                <button type="submit" class="btn sabi-btn-outline-danger mb-2">
                                    <i class="fas fa-trash me-2"></i> Очистить корзину
                                </button>
                            </form>
                            
                            <button class="btn sabi-btn w-100" onclick="checkout()">
                                <i class="fas fa-lock me-2"></i> Оформить заказ
                            </button>
                            
                            <a href="/categories" class="btn sabi-btn-outline w-100 mt-2">
                                <i class="fas fa-shopping-bag me-2"></i> Продолжить покупки
                            </a>
                        </div>

                        <!-- Гарантии -->
                        <div class="sabi-order-guarantees mt-4">
                            <div class="guarantee-item">
                                <i class="fas fa-shipping-fast text-primary"></i>
                                <span>Бесплатная доставка от 3000 ₽</span>
                            </div>
                            <div class="guarantee-item">
                                <i class="fas fa-leaf text-success"></i>
                                <span>Свежие цветы с гарантией</span>
                            </div>
                            <div class="guarantee-item">
                                <i class="fas fa-shield-alt text-warning"></i>
                                <span>Безопасная оплата</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <!-- Пустая корзина -->
        <div class="sabi-empty-cart">
            <div class="empty-cart-icon">
                <i class="fas fa-shopping-cart fa-5x"></i>
            </div>
            <h3 class="empty-cart-title">Ваша корзина пуста</h3>
            <p class="empty-cart-text">
                Кажется, вы ещё не добавили товары в корзину.<br>
                Посмотрите наши букеты и аксессуары — они вам понравятся!
            </p>
            <div class="empty-cart-actions">
                <a href="/categories" class="sabi-btn">
                    <i class="fas fa-store me-2"></i> Перейти к покупкам
                </a>
                <a href="/" class="sabi-btn sabi-btn-outline">
                    <i class="fas fa-home me-2"></i> На главную
                </a>
            </div>
            
            <!-- Рекомендации -->
            <div class="empty-cart-recommendations mt-5">
                <h4 class="text-center mb-4">Популярные товары</h4>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    <div class="col">
                        <div class="sabi-recommendation-card">
                            <div class="recommendation-image">
                                <i class="fas fa-bouquet fa-3x"></i>
                            </div>
                            <div class="recommendation-content">
                                <h5>Романтический букет</h5>
                                <p>Идеально для свидания</p>
                                <a href="/categories/bouquets" class="sabi-link">Смотреть →</a>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="sabi-recommendation-card">
                            <div class="recommendation-image">
                                <i class="fas fa-rose fa-3x"></i>
                            </div>
                            <div class="recommendation-content">
                                <h5>Розы премиум</h5>
                                <p>Элитные сорта</p>
                                <a href="/categories/roses" class="sabi-link">Смотреть →</a>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="sabi-recommendation-card">
                            <div class="recommendation-image">
                                <i class="fas fa-gift fa-3x"></i>
                            </div>
                            <div class="recommendation-content">
                                <h5>Цветы с подарком</h5>
                                <p>Комплекты со скидкой</p>
                                <a href="/categories/gifts" class="sabi-link">Смотреть →</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

