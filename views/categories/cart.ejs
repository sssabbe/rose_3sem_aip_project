<script>
    // Обновление количества товара
    function updateQuantity(index, change) {
        // Здесь должен быть AJAX-запрос к серверу
        // Для демонстрации просто обновляем интерфейс
        const input = document.querySelectorAll('.quantity-input')[index];
        let value = parseInt(input.value) + change;
        
        if (value < 1) value = 1;
        if (value > 99) value = 99;
        
        input.value = value;
        updateCartSummary();
        showNotification(`Количество обновлено`);
    }
    
    function updateQuantityInput(index, value) {
        if (value < 1) value = 1;
        if (value > 99) value = 99;
        
        document.querySelectorAll('.quantity-input')[index].value = value;
        updateCartSummary();
    }
    
    // Удаление товара
    function removeItem(index) {
        if (confirm('Удалить товар из корзины?')) {
            // Здесь должен быть AJAX-запрос к серверу
            const item = document.querySelectorAll('.sabi-cart-item')[index];
            item.style.transform = 'translateX(100%)';
            item.style.opacity = '0';
            
            setTimeout(() => {
                item.remove();
                updateCartSummary();
                showNotification('Товар удален из корзины');
            }, 300);
        }
    }
    
    // Обновление итоговой суммы
    function updateCartSummary() {
        // В реальном приложении здесь будет расчет на сервере
        // Для демонстрации просто обновим цифры
        const items = document.querySelectorAll('.sabi-cart-item');
        let subtotal = 0;
        
        items.forEach(item => {
            const price = parseFloat(item.querySelector('.text-primary').textContent.replace(/[^0-9]/g, ''));
            subtotal += price;
        });
        
        const deliveryCost = document.getElementById('deliveryCost');
        const wrapCost = document.getElementById('wrapCost');
        const totalCost = document.getElementById('totalCost');
        
        // Обновляем отображение
        document.getElementById('subtotal').textContent = subtotal.toLocaleString('ru-RU') + ' ₽';
        
        // Расчет доставки
        const delivery = subtotal > 3000 ? 0 : 300;
        deliveryCost.textContent = delivery === 0 ? 'Бесплатно' : delivery + ' ₽';
        
        // Расчет упаковки
        const wrapSelect = document.getElementById('giftWrap');
        const wrapPrice = parseInt(wrapSelect.value);
        wrapCost.textContent = wrapPrice > 0 ? wrapPrice + ' ₽' : '0 ₽';
        
        // Итог
        const total = subtotal + delivery + wrapPrice;
        totalCost.textContent = total.toLocaleString('ru-RU') + ' ₽';
    }
    
    // Применение промокода
    function applyPromoCode() {
        const promoInput = document.getElementById('promoCode');
        const promoMessage = document.getElementById('promoMessage');
        const code = promoInput.value.trim();
        
        if (!code) {
            promoMessage.textContent = 'Введите промокод';
            promoMessage.className = 'promo-message error';
            return;
        }
        
        // Здесь будет проверка промокода на сервере
        // Для демонстрации используем тестовые промокоды
        const validPromoCodes = {
            'SABI10': 10,
            'FLOWER20': 20,
            'WELCOME': 15
        };
        
        if (validPromoCodes[code.toUpperCase()]) {
            const discount = validPromoCodes[code.toUpperCase()];
            promoMessage.textContent = `Промокод применен! Скидка ${discount}%`;
            promoMessage.className = 'promo-message success';
            
            // Обновляем итоговую сумму со скидкой
            setTimeout(() => {
                updateCartSummary();
            }, 100);
        } else {
            promoMessage.textContent = 'Промокод недействителен';
            promoMessage.className = 'promo-message error';
        }
    }
    
    // Оформление заказа
    function checkout() {
        const comment = document.getElementById('orderComment').value;
        const giftWrap = document.getElementById('giftWrap').value;
        const promoCode = document.getElementById('promoCode').value;
        
        // Здесь будет отправка данных на сервер
        showNotification('Переход к оформлению заказа...');
        
        // В реальном приложении здесь будет редирект на страницу оформления
        setTimeout(() => {
            window.location.href = '/checkout';
        }, 1000);
    }
    
    // Продолжить покупки
    function continueShopping() {
        window.location.href = '/categories';
    }
    
    // Слушатели событий
    document.addEventListener('DOMContentLoaded', function() {
        updateCartSummary();
        
        // Обновляем итог при изменении упаковки
        document.getElementById('giftWrap').addEventListener('change', updateCartSummary);
        
        // Ввод промокода по Enter
        document.getElementById('promoCode').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyPromoCode();
            }
        });
        
        // Анимация появления товаров
        const items = document.querySelectorAll('.sabi-cart-item');
        items.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateX(-20px)';
            
            setTimeout(() => {
                item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                item.style.opacity = '1';
                item.style.transform = 'translateX(0)';
            }, index * 100);
        });
    });
    
    // Функция уведомлений (из предыдущего кода)
    function showNotification(message) {
        const notification = document.createElement('div');
        notification.className = 'sabi-notification';
        notification.innerHTML = `
            <div class="notification-content">
                <i class="fas fa-check-circle"></i>
                <span>${message}</span>
            </div>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.classList.add('show');
        }, 10);
        
        setTimeout(() => {
            notification.classList.remove('show');
            setTimeout(() => {
                notification.remove();
            }, 300);
        }, 3000);
    }
</script>