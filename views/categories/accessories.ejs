<!-- views/categories/accessories.ejs -->
<div class="container mt-5">
    <h1 class="mb-4">🎀 Аксессуары</h1>
    
    <% if (products && products.length > 0) { %>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Цена</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(product => { %>
                <tr>
                    <td><%= product.name %></td>
                    <td><%= product.description || '-' %></td>
                    <td class="text-success fw-bold"><%= product.price %> ₽</td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p class="text-muted">Аксессуары не найдены.</p>
    <% } %>
    
    <a href="/categories" class="btn btn-secondary">Назад</a>
</div>