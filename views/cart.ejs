<div class="container">
    <h1 class="mb-4"><i class="fas fa-shopping-cart"></i> Корзина</h1>
    
    <% if (cart.items.length === 0) { %>
        <div class="alert alert-info">
            <h4 class="alert-heading">Ваша корзина пуста</h4>
            <p>Добавьте товары из каталога, чтобы продолжить.</p>
            <hr>
            <a href="/roses" class="btn btn-primary">Перейти к розам</a>
            <a href="/bouquets" class="btn btn-outline-primary">Перейти к букетам</a>
        </div>
    <% } else { %>
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Товары в корзине</h5>
                        
                        <% cart.items.forEach(item => { %>
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <i class="fas fa-rose fa-3x text-primary"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <h5><%= item.name %></h5>
                                            <p class="text-muted mb-0">Категория: <%= item.category %></p>
                                            <small class="text-muted">Добавлено: <%= item.addedAt %></small>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="input-group">
                                                <span class="input-group-text">Кол-во</span>
                                                <input type="number" class="form-control" value="<%= item.quantity %>" min="1">
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <h5><%= item.price * item.quantity %> ₽</h5>
                                            <p class="text-muted mb-0"><%= item.price %> ₽ × <%= item.quantity %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Итого</h5>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Товары (<%= cart.items.length %>)</span>
                            <span><%= cart.total %> ₽</span>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span>Доставка</span>
                            <span>Бесплатно</span>
                        </div>
                        
                        <hr>
                        
                        <div class="d-flex justify-content-between mb-4">
                            <h5>К оплате</h5>
                            <h5 class="text-primary"><%= cart.total %> ₽</h5>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a href="/checkout" class="btn btn-primary btn-lg">
                                <i class="fas fa-credit-card"></i> Оформить заказ
                            </a>
                            <form action="/clear-cart" method="POST" class="d-grid">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="fas fa-trash"></i> Очистить корзину
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>