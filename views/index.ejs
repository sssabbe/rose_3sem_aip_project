<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="/">🌹 Магазин цветов</a>
            <div class="navbar-nav">
                <span class="nav-item nav-link">
                    Посещений: <%= visitCount %>
                </span>
                <span class="nav-item nav-link">
                    Сессия: <%= sessionVisitCount %>
                </span>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h1>Добро пожаловать в магазин цветов!</h1>
        
        <!-- Каталог роз -->
        <h2 class="mt-5">Наши розы</h2>
        <div class="row">
            <% roses.forEach(rose => { %>
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><%= rose.name %></h5>
                        <p class="card-text"><%= rose.description %></p>
                        <p class="card-text"><strong><%= rose.price %> ₽</strong></p>
                        <form action="/add-to-cart" method="POST">
                            <input type="hidden" name="productId" value="<%= rose.id %>">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-primary">Добавить в корзину</button>
                        </form>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>

        <!-- Каталог букетов -->
        <h2 class="mt-5">Готовые букеты</h2>
        <div class="row">
            <% bouquets.forEach(bouquet => { %>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><%= bouquet.name %></h5>
                        <p class="card-text"><%= bouquet.description %></p>
                        <p class="card-text"><strong><%= bouquet.price %> ₽</strong></p>
                        <form action="/add-to-cart" method="POST">
                            <input type="hidden" name="productId" value="<%= bouquet.id %>">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-success">Добавить в корзину</button>
                        </form>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>

        <!-- Корзина -->
        <h2 class="mt-5">🛒 Ваша корзина</h2>
        <% if (cart.items.length > 0) { %>
            <div class="card">
                <div class="card-body">
                    <% cart.items.forEach(item => { %>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <strong><%= item.name %></strong>
                            <span class="text-muted">× <%= item.quantity %></span>
                            <span class="ms-3"><%= item.price * item.quantity %> ₽</span>
                        </div>
                        <form action="/remove-from-cart" method="POST" class="mb-0">
                            <input type="hidden" name="productId" value="<%= item.id %>">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </div>
                    <% }); %>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Итого: <%= cart.total %> ₽</h4>
                        <form action="/clear-cart" method="POST" class="mb-0">
                            <button type="submit" class="btn btn-warning">Очистить корзину</button>
                        </form>
                    </div>
                    <p class="text-muted mt-2 mb-0">
                        <small>Обновлено: <%= cart.lastUpdated %></small>
                    </p>
                </div>
            </div>
        <% } else { %>
            <div class="alert alert-info">
                Корзина пуста. Добавьте товары из каталога!
            </div>
        <% } %>

        <!-- Информация -->
        <div class="row mt-5">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">🍪 Куки</div>
                    <div class="card-body">
                        <p>Посещений: <strong><%= visitCount %></strong></p>
                        <p>Последний визит: <strong><%= lastVisit %></strong></p>
                        <a href="/clear-cookies" class="btn btn-sm btn-outline-secondary">Очистить куки</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">🔐 Сессия</div>
                    <div class="card-body">
                        <p>Посещений в сессии: <strong><%= sessionVisitCount %></strong></p>
                        <p>Первое посещение: <strong><%= firstVisit %></strong></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Форма имени -->
        <div class="card mt-4">
            <div class="card-header">✏️ Ваше имя</div>
            <div class="card-body">
                <form action="/set-name" method="POST">
                    <div class="mb-3">
                        <input type="text" name="userName" class="form-control" 
                               value="<%= userName === 'Гость' ? '' : userName %>" 
                               placeholder="Введите ваше имя">
                    </div>
                    <button type="submit" class="btn btn-primary">Сохранить имя</button>
                </form>
            </div>
        </div>
    </div>

    <footer class="mt-5 py-3 bg-light text-center">
        <div class="container">
            <p class="mb-0">Магазин цветов "Роза" • Сессии и куки работают!</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>